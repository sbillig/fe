// A trait impl's self type supplies its record's condition.
trait Get { const fn get(self) -> u256 }
struct Bounded<const N: usize> where N > 0 { value: u256 }
const fn positive<const N: usize>() -> u256 where N > 0 { 1 }

impl<const N: usize> Get for Bounded<N> {
    const fn get(self) -> u256 { self.value + positive<N>() }
}

const fn answer() -> u256 { Bounded<2> { value: 41 }.get() }
