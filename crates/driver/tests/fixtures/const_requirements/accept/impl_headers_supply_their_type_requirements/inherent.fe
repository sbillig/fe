// A generic impl of a constrained record may assume the record's condition
// for its own header type, in signatures and bodies.
struct Bounded<const N: usize> where N > 0 { value: u256 }
const fn positive<const N: usize>() -> u256 where N > 0 { 1 }

impl<const N: usize> Bounded<N> {
    const fn make(_ value: u256) -> Self { Bounded { value: value } }
    const fn get(self) -> u256 { self.value + positive<N>() }
    const fn total(self) -> u256 { self.get() + Self::make(1).get() }
}

const fn answer() -> u256 { Bounded<1> { value: 39 }.total() }
