target = "evm-ethereum-osaka"

func private %main() -> i64 {
    block0:
        jump block1;

    block1:
        (v2.i64, v3.i1) = usubo 1.i64 2.i64;
        br v3 block2 block3;

    block2:
        evm_revert_word 1313373041.i32 17.i256;

    block3:
        return v2;
