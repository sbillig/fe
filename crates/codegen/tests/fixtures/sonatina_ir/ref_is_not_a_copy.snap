---
target = "evm-ethereum-osaka"

type @layout_0 = {i256, i256};
type @layout_1 = {constref<i256>, constref<i256>};

global private const @layout_0 $const_region_0 = {10, 20};

func private %main() {
    block0:
        jump block1;

    block1:
        call %test_ref_is_not_a_copy;
        return;
}

func private %main_root() {
    block0:
        jump block1;

    block1:
        call %main;
        evm_stop;
}

func private %test_ref_is_not_a_copy() {
    block0:
        v0.objref<@layout_1> = obj.alloc @layout_1;
        jump block1;

    block1:
        v3.constref<@layout_0> = const.ref $const_region_0;
        v4.constref<@layout_0> = const.ref $const_region_0;
        jump block9;

    block2:
        jump block4;

    block3:
        jump block11;

    block4:
        v6.i256 = const.load v12;
        jump block13;

    block5:
        jump block7;

    block6:
        evm_revert_word 1313373041.i32 1.i256;

    block7:
        return;

    block8:
        obj.store v0 v18;
        v11.constref<i256> = extract_value v18 0.i256;
        v12.constref<i256> = extract_value v18 1.i256;
        v13.i256 = const.load v11;
        v14.i1 = eq v13 10.i256;
        br v14 block2 block3;

    block9:
        v16.constref<i256> = const.proj v4 0.i256;
        v17.constref<i256> = const.proj v4 1.i256;
        v18.@layout_1 = agg.make @layout_1 v16 v17;
        jump block8;

    block10:
        evm_revert_word 1313373041.i32 1.i256;

    block11:
        jump block10;

    block12:
        v20.i1 = eq v6 20.i256;
        br v20 block5 block6;

    block13:
        jump block12;
}


object @main {
    section main {
        entry %main_root;
    }
}
