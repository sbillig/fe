struct view {}

fn ordinary(value: view) {}

fn explicit_mode(value: view view) {}

fn qualified_mode<T: Trait>(value: view <T as Trait>::Item) {}

fn closure_modes() {
    let inferred_mode = |value: view| value
    let explicit_mode = |value: view view| value
    let generic_type = |value: view<u256>| value
    let qualified_type = |value: view::Nested| value
}
