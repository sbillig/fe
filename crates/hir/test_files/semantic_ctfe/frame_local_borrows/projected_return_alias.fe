trait Pick {
    type Out
    const fn pick(_ value: mut u8) -> Self::Out
}

struct Alias {}
impl Pick for Alias {
    type Out = mut u8
    const fn pick(_ value: mut u8) -> mut u8 { mut value }
}

// `via<Alias>` returns a borrow only after its result type is instantiated.
const fn via<T: Pick>(_ value: mut u8) -> T::Out {
    T::pick(mut value)
}

const fn answer() -> u8 {
    let mut x: u8 = 0
    let a: mut u8 = via<Alias>(mut x)
    a = 42
    x
}
