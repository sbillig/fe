// Two layouts that grow without bound, each through a wrapper around the
// repeated type: `Wrapped<T>` holds `Wrapped<Option<T>>`, and `Ping<T>` holds
// `Ping<Option<(T, u8)>>` through `Pong`. Each must be reported as a
// non-regular cycle, in bounded time, rather than expanded forever.
struct Rooted<const ROOT: u256 = _> {}

struct Wrapped<T, const ROOT: u256 = _> {
    marker: Rooted<ROOT>,
    next: Wrapped<Option<T>, ROOT>,
}

struct Ping<T, const ROOT: u256 = _> {
    marker: Rooted<ROOT>,
    pong: Pong<(T, u8), ROOT>,
}

struct Pong<T, const ROOT: u256 = _> {
    marker: Rooted<ROOT>,
    ping: Ping<Option<T>, ROOT>,
}

fn inspect_wrapped(value: Wrapped<u256>) {}

fn inspect_ping(value: Ping<u256>) {}
