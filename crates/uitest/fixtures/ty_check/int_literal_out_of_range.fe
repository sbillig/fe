fn annotated() -> u8 {
    let x: u8 = 300
    x
}

fn inferred(x: u16) -> u16 {
    x + 65536
}

fn pattern(x: u8) -> bool {
    match x {
        256 => true
        _ => false
    }
}

// `usize` is 64 bits on native targets.
fn usize_literal() -> usize {
    0x10000000000000000
}

fn isize_literal() -> isize {
    0x8000000000000000
}

fn in_range() -> (u8, i8, usize, isize) {
    (255, -128, 0xffffffffffffffff, -0x8000000000000000)
}
