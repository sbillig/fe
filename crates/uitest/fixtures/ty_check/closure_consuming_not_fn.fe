use core::functional::Fn

struct Boxed {
    value: u256,
}

fn invoke<T, U, F: Fn<(T,), U>>(_ func: F, _ value: own T) -> U {
    func.call(value)
}

pub fn closure_consuming_not_fn() -> Boxed {
    let boxed = Boxed { value: 42 }
    let take = |_ unit: own ()| -> Boxed { boxed }
    invoke(func: take, value: ())
}
