// A state-only type has no value reading, so a plain name binds its read
// access, wherever the binding stands; `mut` binds the mutable one.
use std::evm::StorageMap

enum Choice<T> {
    Primary(T),
    Secondary(T),
}

impl<T: Copy> Copy for Choice<T> {}

impl Choice<StorageMap<u256, u256>> {
    // S-68. Accepted: a plain payload binding reads the map.
    fn get(self, _ key: u256) -> u256 {
        if let Choice::Primary(map) = self {
            map.get(key)
        } else {
            0
        }
    }

    // S-68. Rejected: a write through the plain binding's read access.
    fn set_plain(mut self, _ key: u256) {
        if let Choice::Primary(map) = self {
            map[key] = 1
        }
    }

    // S-68. Accepted: `mut map` writes.
    fn set(mut self, _ key: u256) {
        if let Choice::Primary(mut map) = self {
            map[key] = 1
        }
    }
}
