// The type before `::` enters the program even when a blanket impl supplies
// the item, so it is checked like a written type.
struct Bounded<const N: usize> where N > 0 { value: u256 }
enum Choice<const N: usize> where N > 0 { Empty }
trait Helper {
    const X: u256
    fn helper() -> u256
}
impl<T> Helper for T {
    const X: u256 = 1
    fn helper() -> u256 { 1 }
}

fn call() -> u256 { Bounded<0>::helper() }
fn constant() -> u256 { Bounded<0>::X }
fn enum_call() -> u256 { Choice<0>::helper() }
fn value() {
    let _helper = Bounded<0>::helper
}
fn value_call() -> u256 {
    let helper = Bounded<0>::helper
    helper()
}
fn allowed() -> u256 { Bounded<1>::helper() + Bounded<1>::X + Choice<1>::helper() }
