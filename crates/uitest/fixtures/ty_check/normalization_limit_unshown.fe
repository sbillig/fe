// A normalization limit is an error even where no type shows it: here it is
// reached only while the trait solver compares `Out` with the bound's `u8`,
// on a projection nested more deeply than the limit allows, and the type that
// stands in for the projection matches any type. Nothing written has a
// projection past the limit, and the call's type is `()`.
trait Nest {
    type Out
}

struct N<T> {
    t: T,
}

impl<T: Nest> Nest for N<T> {
    type Out = T::Out
}

impl Nest for u8 {
    type Out = u8
}

fn need<T: Nest<Out = u8>>() {}

fn caller() {
    need<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<N<u8>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>()
}

fn shallow() {
    need<N<N<N<u8>>>>()
}
