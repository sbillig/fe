// `core::marker::Borrows` views, such as `MemSlice`, hold a shared borrow of
// the value they were derived from.
use core::ops::IndexMut
use core::ptr::{MemArray, MemBuffer, MemSlice, MemSpan}

struct Table {
    data: MemArray<u256>,
}

impl Table {
    fn view(self) -> MemSlice<u256> {
        self.data.as_slice()
    }

    fn set(mut self, _ value: u256) {
        let slot = self.data.index_mut(0)
        slot = value
    }
}

struct Reader {
    input: MemSpan,
    pos: u256,
}

impl Reader {
    fn input(self) -> MemSpan {
        self.input
    }

    fn advance(mut self) {
        self.pos += 1
    }

    // Rejected: a method can only return views derived from `self`.
    fn other(self, _ buffer: ref MemBuffer) -> MemSpan {
        buffer.span()
    }
}

// Rejected: a view keeps its owner borrowed.
fn owner_mutated_while_viewed() -> u256 {
    let mut a = MemArray<u256>::new_zeroed(1)
    let s = a.as_slice()
    let h = a.index_mut(0)
    let v = s[0]
    h = 7
    v
}

// Rejected: a view derived through a wrapper that owns memory borrows the
// wrapper.
fn wrapper_mutated_while_viewed() -> u256 {
    let mut table = Table { data: MemArray<u256>::new_zeroed(1) }
    let s = table.view()
    table.set(1)
    s[0]
}

// Accepted: replacing an owner does not change the memory its views borrow.
fn owner_replaced_while_viewed() -> u256 {
    let mut a = MemArray<u256>::new_zeroed(1)
    let s = a.as_slice()
    a = MemArray<u256>::new_zeroed(2)
    s[0] + a.len()
}

// Accepted: a view of a view borrows what the first one borrows.
fn view_narrowed_in_place(_ a: MemArray<u256>) -> u256 {
    let mut s = a.as_slice()
    s = s.slice(offset: 0, len: 1)
    s.len()
}

// Accepted: a view a wrapper holds is not a borrow of the wrapper.
fn reader_advanced_while_input_viewed(_ buffer: MemBuffer) -> u256 {
    let mut reader = Reader { input: buffer.span(), pos: 0 }
    let input = reader.input()
    reader.advance()
    input.len()
}

// Accepted: the memory a view borrows outlives a local owner.
fn return_view_of_local_owner() -> MemSpan {
    let buffer = MemBuffer::alloc(4)
    buffer.span()
}

// Rejected: storage cannot hold a view.
pub contract StoredView {
    mut span: MemSpan,

    init() uses (mut span) {
        let buffer = MemBuffer::alloc(4)
        span = buffer.span()
    }
}
