// Boolean choices keep allocation-family alternatives correlated through joins.
struct Item { n: u256 }
fn consume(_ item: own Item) {}
fn initialized(_ n: u256) -> *Item {
    let p = core::ptr::alloc<Item>()
    *p = Item { n }
    p
}
fn forward(_ n: u256) -> *Item { initialized(n) }

// Accepted: the joined pointer is fresh on either boolean branch.
fn example(count: u256) {
    let mut i: u256 = 0
    while i < count {
        let p = if i == 0 { initialized(i) } else { forward(i) }
        consume(*p)
        i += 1
    }
}

// Rejected: consuming the selected pointer twice still moves the same object.
fn duplicate_move(count: u256) {
    let mut i: u256 = 0
    while i < count {
        let p = if i == 0 { initialized(i) } else { forward(i) }
        consume(*p)
        consume(*p)
        i += 1
    }
}

// Accepted: consume each fresh value before joining the branches.
fn consume_in_branch(count: u256) {
    let mut i: u256 = 0
    while i < count {
        if i == 0 { consume(*initialized(i)) } else { consume(*forward(i)) }
        i += 1
    }
}

// Accepted: enum selection retains its guard through the join.
fn enum_selected(count: u256, choice: Choice) {
    let mut i: u256 = 0
    while i < count {
        let p = match choice { Choice::First => initialized(i), Choice::Second => forward(i) }
        consume(*p)
        i += 1
    }
}

enum Choice { First, Second }
impl Copy for Choice {}

fn maybe(_ flag: bool, _ old: *Item) -> *Item {
    if flag { initialized(1) } else { old }
}

// Rejected: the factory may return the old pointer after it was moved.
fn old_moved_before_selection(flag: bool) {
    let old = initialized(0)
    consume(*old)
    let selected = maybe(flag, old)
    consume(*selected)
}

// Rejected: independent calls may both return the old pointer.
fn independent_choices(flag: bool, other: bool) {
    let old = initialized(0)
    let first = maybe(flag, old)
    let second = maybe(other, old)
    consume(*first)
    consume(*second)
}

// Accepted: each consume is guarded by the choice that made its value fresh.
fn guarded_independent_choices(flag: bool, other: bool) {
    let old = initialized(0)
    let first = maybe(flag, old)
    let second = maybe(other, old)
    if flag { consume(*first) }
    if other { consume(*second) }
    consume(*old)
}

fn read(_ slot: *ref u256) -> u256 { *slot }

// Accepted: the native slot is read only on the branch that initialized it.
fn guarded_native_read(flag: bool) -> u256 {
    let owner = core::ptr::alloc<u256>()
    *owner = 7
    let native = ref *owner
    let slot = core::ptr::alloc<ref u256>()
    if flag { *slot = native }
    if flag { read(slot) } else { 0 }
}

// Rejected: the other branch leaves the native slot uninitialized.
fn unguarded_native_read(flag: bool) -> u256 {
    let owner = core::ptr::alloc<u256>()
    *owner = 7
    let native = ref *owner
    let slot = core::ptr::alloc<ref u256>()
    if flag { *slot = native }
    read(slot)
}

// Rejected: a mutable boolean from an earlier iteration does not select this
// iteration's fresh allocation.
fn repeated_boolean_load(count: u256) {
    let old = initialized(0)
    let mut flag = true
    let mut i: u256 = 0
    while i < count {
        let selected = if flag { initialized(i) } else { old }
        flag = false
        consume(*selected)
        i += 1
    }
}
