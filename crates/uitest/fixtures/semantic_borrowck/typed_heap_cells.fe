// A constant typed-cell store is recovered by a symbolic read at a matching
// caller; other members keep unknown contents that may alias the cursor.
use core::ptr

fn store_zero_read_index(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[0] = data.span()
    let child = children[index]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}

// Accepted: the matching caller reads the stored zero member.
pub fn zero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_zero_read_index(cursor: mut cursor, index: 0)
}

// Rejected: member one was never written.
pub fn zero_cell_wrong_index() -> u256 {
    let mut cursor: u256 = 0
    store_zero_read_index(cursor: mut cursor, index: 1)
}

fn store_one_read_index(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[1] = data.span()
    let child = children[index]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}

// Accepted: the matching caller reads the stored nonzero member.
pub fn nonzero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_one_read_index(cursor: mut cursor, index: 1)
}

// Rejected: member zero was never written.
pub fn nonzero_cell_wrong_index() -> u256 {
    let mut cursor: u256 = 0
    store_one_read_index(cursor: mut cursor, index: 0)
}

fn store_index_read_index(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[index] = data.span()
    let child = children[index]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}

// Accepted: the same symbolic selector stores and reads one member.
pub fn same_symbolic_cell() -> u256 {
    let mut cursor: u256 = 0
    store_index_read_index(cursor: mut cursor, index: 0)
}

fn store_zero_read_zero(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[0] = data.span()
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}

// Accepted: a literal read of the stored zero member.
pub fn literal_zero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_zero_read_zero(cursor: mut cursor, index: 0)
}

fn store_one_read_one(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[1] = data.span()
    let child = children[1]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}

// Accepted: a literal read of the stored nonzero member.
pub fn literal_nonzero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_one_read_one(cursor: mut cursor, index: 1)
}

// Rejected: a literal read of an unwritten member.
fn store_zero_read_one(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[0] = data.span()
    let child = children[1]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn literal_wrong_nonzero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_zero_read_one(cursor: mut cursor, index: 0)
}

// Rejected: a literal read of the other unwritten member.
fn store_one_read_zero(cursor: mut u256, index: usize) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let data = ptr::MemBuffer::alloc(32)
    *ptr::cast<u8, u256>(data.ptr()) = 7
    children[1] = data.span()
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn literal_wrong_zero_cell() -> u256 {
    let mut cursor: u256 = 0
    store_one_read_zero(cursor: mut cursor, index: 1)
}
