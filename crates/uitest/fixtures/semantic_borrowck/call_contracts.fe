// Calls are checked against signatures: a borrow a call returns comes from a
// capability-carrying `self` receiver, or else from every argument.
struct Holder { value: u256 }

impl Holder {
    fn get(self) -> ref u256 {
        ref self.value
    }

    fn len(self) -> u256 {
        1
    }

    fn set(mut self, _ value: u256) {
        self.value = value
    }
}

struct Slot { r: ref u256 }

fn pick(_ a: ref u256, _ b: ref u256) -> ref u256 {
    a
}

fn store(_ slot: mut Slot, _ r: ref u256) {
    slot = Slot { r }
}

// Accepted: a method result borrows only from `self`.
fn result_from_self(_ key: u256) -> u256 {
    let holder = Holder { value: 1 }
    let mut other: u256 = key
    let r = holder.get()
    other = 3
    r + other
}

// Rejected: the receiver stays borrowed while the method result is live.
fn receiver_borrowed_by_result() -> u256 {
    let mut holder = Holder { value: 1 }
    let r = holder.get()
    holder.set(2)
    r
}

// Rejected: without `self`, the result borrows from every argument.
fn union_of_arguments() -> u256 {
    let a: u256 = 1
    let mut b: u256 = 2
    let r = pick(ref a, ref b)
    b = 3
    r
}

// Accepted: a two-phase receiver can be read while evaluating arguments.
fn two_phase_receiver() {
    let mut holder = Holder { value: 1 }
    holder.set(holder.len())
}

// Rejected: a mutable argument that can hold borrows may keep any other argument's.
fn borrow_flows_into_mutable_argument() -> u256 {
    let a: u256 = 1
    let mut b: u256 = 2
    let mut slot = Slot { r: ref a }
    store(mut slot, ref b)
    b = 3
    slot.r
}
