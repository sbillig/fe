fn direct(_ value: mut u256) -> mut u256 { value }
fn tuple(_ value: mut u256) -> (mut u256,) { (value,) }

// Rejected: a direct returned loan overlaps the second borrow.
fn direct_conflict() {
    let mut value: u256 = 0
    let first = direct(mut value)
    let second = mut value
    second = 1
    first = 2
}

// Rejected: tuple destructuring preserves the same live loan.
fn tuple_conflict() {
    let mut value: u256 = 0
    let (first,) = tuple(mut value)
    let second = mut value
    second = 1
    first = 2
}

// Accepted: the first direct loan ends before the second starts.
fn direct_last_use() {
    let mut value: u256 = 0
    let first = direct(mut value)
    first = 2
    let second = mut value
    second = 1
}

// Accepted: the same last-use rule applies after tuple destructuring.
fn tuple_last_use() {
    let mut value: u256 = 0
    let (first,) = tuple(mut value)
    first = 2
    let second = mut value
    second = 1
}
