use core::ptr

// Rejected: both pointers name `base + 3`.
fn nested_byte_offsets() -> u8 {
    let base = ptr::alloc_bytes(5)
    let left = ptr::offset_bytes(ptr::offset_bytes(base, 1), 2)
    let right = ptr::offset_bytes(ptr::offset_bytes(base, 2), 1)
    *left = 1
    let loan = mut *left
    let result = *right
    loan = 3
    result
}

// Rejected: words at `base + 2` and `base + 3` share 31 bytes.
fn overlapping_words_after_casts() -> u256 {
    let base = ptr::alloc_bytes(96)
    ptr::zero_bytes(base, 96)
    let left = ptr::cast<u8, u256>(ptr::offset_bytes(ptr::offset_bytes(base, 1), 1))
    let right = ptr::cast<u8, u256>(ptr::offset_bytes(ptr::offset_bytes(base, 2), 1))
    *left = 1
    let loan = mut *left
    let result = *right
    loan = 3
    result
}
