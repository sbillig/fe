struct Item { n: u256 }
trait Operation { fn apply(pointer: *Item) }

// Template validation after apply remains pending until T is selected.
fn generic<T: Operation>(pointer: *Item) -> Item {
    T::apply(pointer)
    *pointer
}

struct Consume {}
impl Operation for Consume {
    fn apply(pointer: *Item) { let moved = *pointer }
}
// Rejected: Consume moves the pointee before generic reads it.
fn concrete(pointer: *Item) -> Item { generic<Consume>(pointer) }

struct Noop {}
impl Operation for Noop {
    fn apply(pointer: *Item) {}
}
// Accepted: Noop preserves the pointee.
fn concrete_noop(pointer: *Item) -> Item { generic<Noop>(pointer) }
