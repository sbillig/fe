// A fill loop certifies no member that some iteration can leave unwritten.
use core::ptr

// Rejected: zero iterations write no member.
fn staged_without_iterations(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_staged_without_iterations() -> u256 {
    let mut cursor: u256 = 0
    staged_without_iterations(mut cursor, 0)
}

// Rejected: a single-slot write does not initialize member one.
fn staged_other_member(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[0] = data.span()
        i += 1
    }
    if count == 0 { return 0 }
    let child = children[1]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_staged_other_member() -> u256 {
    let mut cursor: u256 = 0
    staged_other_member(mut cursor, 2)
}

// Rejected: the first iteration skips its store.
fn staged_skipped_store(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        if i != 0 { children[i as usize] = data.span() }
        i += 1
    }
    if count == 0 { return 0 }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_staged_skipped_store() -> u256 {
    let mut cursor: u256 = 0
    staged_skipped_store(mut cursor, 2)
}

// Rejected: an early break leaves member one unwritten.
fn staged_early_break(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        if i == 1 { break }
        children[i as usize] = data.span()
        i += 1
    }
    let child = children[1]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_staged_early_break() -> u256 {
    let mut cursor: u256 = 0
    staged_early_break(mut cursor, 2)
}

// Rejected: a loop that may not run leaves the single slot unwritten.
fn repeat_cell_maybe_empty(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(1)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        children[0] = data.span()
        i += 1
    }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_repeat_cell_maybe_empty() -> u256 {
    let mut cursor: u256 = 0
    repeat_cell_maybe_empty(mut cursor, 0)
}

// Rejected: a bound changed inside the loop certifies no member beyond it.
fn changed_bound(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
    let mut limit: u256 = count
    let mut i: u256 = 0
    while i < limit {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        limit = 1
        i += 1
    }
    if count < 2 { return 0 }
    let child = children[1]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_changed_bound() -> u256 {
    let mut cursor: u256 = 0
    changed_bound(mut cursor, 2)
}

// Rejected: a reborn array does not inherit earlier members.
fn reset_cells(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
    let mut i: u256 = 0
    while i < count {
        children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    if count == 0 { return 0 }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_reset_cells() -> u256 {
    let mut cursor: u256 = 0
    reset_cells(mut cursor, 2)
}
