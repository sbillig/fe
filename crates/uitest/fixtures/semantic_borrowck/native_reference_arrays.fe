use core::ptr

struct Mixed { a: [ref u256; 2], b: [[ref u256; 2]; 2] }

fn consume(_ value: own [ref u256; 2]) {}
fn consume_mixed(_ value: own Mixed) {}

// Rejected: an uninitialized array has no native references.
fn load_uninitialized() {
    let pointer = ptr::alloc<[ref u256; 2]>()
    consume(*pointer)
}

// Rejected: array leaves at different depths share one requirement.
fn load_uninitialized_mixed() {
    let pointer = ptr::alloc<Mixed>()
    consume_mixed(*pointer)
}

// Accepted: every nested member is initialized.
fn load_initialized_mixed() {
    let value: u256 = 0
    let pointer = ptr::alloc<Mixed>()
    *pointer = Mixed {
        a: [ref value, ref value],
        b: [[ref value, ref value], [ref value, ref value]],
    }
    consume_mixed(*pointer)
}

// Rejected: zeroing a byte of the array invalidates its references.
fn clobber_then_load(values: *[ref u256; 2]) {
    ptr::zero_bytes(ptr::cast<[ref u256; 2], u8>(values), 1)
    consume(*values)
}

fn clobber_other_then_load(values: *[ref u256; 2], other: *u8) {
    ptr::zero_bytes(other, 1)
    consume(*values)
}

// Accepted: the caller proves the clobbered bytes are elsewhere.
fn clobber_disjoint() {
    let value: u256 = 0
    let values = ptr::alloc<[ref u256; 2]>()
    *values = [ref value, ref value]
    let other = ptr::alloc<u8>()
    clobber_other_then_load(values, other)
}

// Rejected: the clobbered bytes belong to the array.
fn clobber_overlapping() {
    let value: u256 = 0
    let values = ptr::alloc<[ref u256; 2]>()
    *values = [ref value, ref value]
    clobber_other_then_load(values, other: ptr::cast<[ref u256; 2], u8>(values))
}
