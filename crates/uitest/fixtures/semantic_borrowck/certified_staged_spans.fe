// A verified fill loop certifies the fresh span stored in each written member.
use core::ptr

// Accepted: after a nonempty fill, member zero holds a fresh span, not the cursor.
fn stage_and_read(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    if count == 0 { return 0 }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_stage_and_read(_ count: u256) -> u256 {
    let mut cursor: u256 = 0
    stage_and_read(mut cursor, count)
}

// Accepted: a second loop reads every member within the certified bound.
fn stage_and_sum(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    let mut j: u256 = 0
    let mut sum: u256 = 0
    while j < count {
        let child = children[j as usize]
        cursor += 1
        sum += *ptr::cast<u8, u256>(child.ptr())
        j += 1
    }
    sum
}
pub fn run_stage_and_sum(_ count: u256) -> u256 {
    let mut cursor: u256 = 0
    stage_and_sum(mut cursor, count)
}

fn make_children(_ count: u256) -> ptr::MemArray<ptr::MemSpan> {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(count)
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    children
}

// Accepted: a returned array carries its certified range to the caller.
fn read_returned_first(_ cursor: mut u256, _ count: u256) -> u256 {
    let children = make_children(count)
    if count == 0 { return 0 }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_read_returned_first(_ count: u256) -> u256 {
    let mut cursor: u256 = 0
    read_returned_first(mut cursor, count)
}

// Accepted: a caller loop reads every member of the returned range.
fn read_returned_all(_ cursor: mut u256, _ count: u256) -> u256 {
    let children = make_children(count)
    let mut j: u256 = 0
    let mut sum: u256 = 0
    while j < count {
        let child = children[j as usize]
        cursor += 1
        sum += *ptr::cast<u8, u256>(child.ptr())
        j += 1
    }
    sum
}
pub fn run_read_returned_all(_ count: u256) -> u256 {
    let mut cursor: u256 = 0
    read_returned_all(mut cursor, count)
}

fn make_uninitialized() -> ptr::MemArray<ptr::MemSpan> {
    ptr::MemArray<ptr::MemSpan>::new_uninit(2)
}

// Rejected: an unfilled returned array has no certified contents.
fn read_uninitialized(_ cursor: mut u256) -> u256 {
    let children = make_uninitialized()
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_read_uninitialized() -> u256 {
    let mut cursor: u256 = 0
    read_uninitialized(mut cursor)
}

fn maybe_children(_ count: u256, _ fill: bool) -> ptr::MemArray<ptr::MemSpan> {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(2)
    if !fill { return children }
    let mut i: u256 = 0
    while i < count {
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[i as usize] = data.span()
        i += 1
    }
    children
}

// Rejected: only one return path establishes the range.
fn read_maybe_filled(_ cursor: mut u256, _ fill: bool) -> u256 {
    let children = maybe_children(2, fill)
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_read_maybe_filled(_ fill: bool) -> u256 {
    let mut cursor: u256 = 0
    read_maybe_filled(mut cursor, fill)
}

// Accepted: a nonempty loop that rewrites one cell leaves its last fresh span.
fn repeat_cell(_ cursor: mut u256, _ count: u256) -> u256 {
    let mut children = ptr::MemArray<ptr::MemSpan>::new_uninit(1)
    let mut i: u256 = 0
    while i < count {
        let noise = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(noise.ptr()) = 4
        let data = ptr::MemBuffer::alloc(32)
        *ptr::cast<u8, u256>(data.ptr()) = 7
        children[0] = data.span()
        i += 1
    }
    if count == 0 { return 0 }
    let child = children[0]
    cursor += 1
    *ptr::cast<u8, u256>(child.ptr())
}
pub fn run_repeat_cell(_ count: u256) -> u256 {
    let mut cursor: u256 = 0
    repeat_cell(mut cursor, count)
}
