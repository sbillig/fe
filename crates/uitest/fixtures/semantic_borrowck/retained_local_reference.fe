use core::ptr

// Rejected: the raw heap slot retains a local borrow at function exit.
fn read_initialized_reference() -> u256 {
    let value: u256 = 7
    let slot = ptr::alloc<ref u256>()
    *slot = ref value
    let result: u256 = *slot
    result
}

// Accepted: the referent itself is heap allocated.
fn heap_referent() -> u256 {
    let owner = ptr::alloc<u256>()
    *owner = 7
    let slot = ptr::alloc<ref u256>()
    *slot = ref *owner
    let result: u256 = *slot
    result
}
