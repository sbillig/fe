use core::ptr

fn select(index: usize, first: *u256, second: *u256) -> *u256 {
    let mut children = ptr::MemArray<*u256>::new_uninit(2)
    children[0] = first
    children[1] = second
    children[index]
}

fn select_first(first: *u256, second: *u256) -> *u256 {
    let mut children = ptr::MemArray<*u256>::new_uninit(2)
    children[0] = first
    children[1] = second
    children[0]
}

// Accepted: the helper returns `first` while `second` is mutably borrowed.
fn first_while_second_borrowed() -> u256 {
    let first = ptr::alloc<u256>()
    *first = 1
    let second = ptr::alloc<u256>()
    *second = 2
    let selected = select(index: 0, first, second)
    let loan = mut *second
    let result = *selected
    loan = 3
    result
}

// Rejected: the helper returns `first` while it is mutably borrowed.
fn first_while_first_borrowed() -> u256 {
    let first = ptr::alloc<u256>()
    *first = 1
    let second = ptr::alloc<u256>()
    *second = 2
    let selected = select(index: 0, first, second)
    let loan = mut *first
    let result = *selected
    loan = 3
    result
}

// Accepted: the helper returns `second` while `first` is mutably borrowed.
fn second_while_first_borrowed() -> u256 {
    let first = ptr::alloc<u256>()
    *first = 1
    let second = ptr::alloc<u256>()
    *second = 2
    let selected = select(index: 1, first, second)
    let loan = mut *first
    let result = *selected
    loan = 3
    result
}

// Rejected: the helper returns `second` while it is mutably borrowed.
fn second_while_second_borrowed() -> u256 {
    let first = ptr::alloc<u256>()
    *first = 1
    let second = ptr::alloc<u256>()
    *second = 2
    let selected = select(index: 1, first, second)
    let loan = mut *second
    let result = *selected
    loan = 3
    result
}

// Accepted: a literal read selects the same element.
fn literal_first_while_second_borrowed() -> u256 {
    let first = ptr::alloc<u256>()
    *first = 1
    let second = ptr::alloc<u256>()
    *second = 2
    let selected = select_first(first, second)
    let loan = mut *second
    let result = *selected
    loan = 3
    result
}
