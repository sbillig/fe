use core::ptr

// Rejected: zero bytes do not establish a native reference.
fn read_zeroed_reference() -> u256 {
    let slot = ptr::alloc<ref u256>()
    ptr::zero_bytes(ptr::byte_ptr(slot), 32)
    let value: u256 = *slot
    value
}

// Rejected: byte copying does not establish a native reference either.
fn copy_reference_bytes() -> u256 {
    let owner = ptr::alloc<u256>()
    *owner = 7
    let source = ptr::alloc<ref u256>()
    *source = ref *owner
    let destination = ptr::alloc<ref u256>()
    ptr::copy_raw(ptr::byte_ptr(destination), source: ptr::byte_ptr(source), len: 32)
    let result: u256 = *destination
    result
}

// Accepted: a typed copy preserves the valid native reference.
fn copy_reference_typed() -> u256 {
    let owner = ptr::alloc<u256>()
    *owner = 7
    let source = ptr::alloc<ref u256>()
    *source = ref *owner
    let destination = ptr::alloc<ref u256>()
    *destination = *source
    let result: u256 = *destination
    result
}

// Accepted: a typed store initializes the native reference slot.
fn read_initialized_reference() -> u256 {
    let owner = ptr::alloc<u256>()
    *owner = 7
    let slot = ptr::alloc<ref u256>()
    *slot = ref *owner
    let result: u256 = *slot
    result
}

// Accepted: native slots allocated in a loop can be returned uninitialized.
fn make_slot(_ n: u256) -> *ref u256 {
    let mut slot = ptr::alloc<ref u256>()
    let mut i: u256 = 0
    while i < n {
        slot = ptr::alloc<ref u256>()
        i += 1
    }
    slot
}
fn discard_returned_slot() {
    let _ = make_slot(3)
}

// Rejected: the returned loop-allocated slot still holds no native reference.
fn read_returned_slot() -> u256 {
    let slot = make_slot(3)
    let value: u256 = *slot
    value
}
