struct Item { n: u256 }
fn consume(_ item: own Item) {}

// Rejected: the selected destination might not restore the moved cell.
fn restore(first: *Item, second: *Item, flag: bool) {
    let old = unsafe { *first }
    let destination = if flag { first } else { second }
    unsafe { *destination = Item { n: 7 } }
    let reused = unsafe { *first }
    consume(old)
    consume(reused)
}

// Accepted: the write definitely restores the moved cell.
fn restore_exact(first: *Item) {
    let old = unsafe { *first }
    let destination = first
    unsafe { *destination = Item { n: 7 } }
    let reused = unsafe { *first }
    consume(old)
    consume(reused)
}
