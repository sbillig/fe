// Fresh recursive results converge through a finite call-result port, while an
// unsupported recursive poststate still fails closed.
struct Item { n: u256 }
fn consume(_ item: own Item) {}
fn initialized(_ n: u256) -> *Item {
    let p = core::ptr::alloc<Item>()
    *p = Item { n }
    p
}

// Accepted: the recursive call returns one newly allocated object.
fn recursive(_ n: u256, depth: u256) -> *Item {
    if depth == 0 { initialized(n) }
    else { recursive(n, depth: depth - 1) }
}
fn example() { consume(*recursive(7, depth: 2)) }

// Accepted: recursion forwards one existing allocation.
fn forward_recursive(_ pointer: *Item, depth: u256) -> *Item {
    if depth == 0 { pointer }
    else { forward_recursive(pointer, depth: depth - 1) }
}
fn forward_existing() { consume(*forward_recursive(initialized(7), depth: 2)) }

// Rejected: the stored pointer can be an older object from the same loop
// allocation site, so reinitializing the result does not restore it.
fn make_with_previous(_ slot: **Item, _ n: u256) -> *Item {
    let mut current = core::ptr::alloc<Item>()
    *slot = current
    let mut i: u256 = 0
    while i < n {
        current = core::ptr::alloc<Item>()
        if i + 1 < n { *slot = current }
        i += 1
    }
    current
}
fn stored_previous_object() {
    let slot = core::ptr::alloc<*Item>()
    let result = make_with_previous(slot, 3)
    *result = Item { n: 1 }
    consume(*(*slot))
    *result = Item { n: 1 }
    consume(*(*slot))
}

// Accepted: fresh recursive results converge inside a caller loop.
fn loop_recursive(_ count: u256) {
    let mut i: u256 = 0
    while i < count {
        let p = recursive(i, depth: 2)
        consume(*p)
        i += 1
    }
}

fn first(_ n: u256, depth: u256) -> *Item {
    if depth == 0 { initialized(n) } else { second(n, depth: depth - 1) }
}
fn second(_ n: u256, depth: u256) -> *Item {
    if depth == 0 { initialized(n) } else { first(n, depth: depth - 1) }
}

// Accepted: mutually recursive fresh results converge.
fn loop_mutual(_ count: u256) {
    let mut i: u256 = 0
    while i < count {
        let p = first(i, depth: 2)
        consume(*p)
        i += 1
    }
}

// Rejected: a later fresh result does not revive an older moved one.
fn older_moved_result() {
    let old = recursive(0, depth: 2)
    consume(*old)
    let fresh = recursive(1, depth: 2)
    consume(*fresh)
    consume(*old)
}

fn maybe(_ old: *Item, _ n: u256, depth: u256, pick: bool) -> *Item {
    if depth == 0 {
        if pick { initialized(n) } else { old }
    } else { maybe(old, n, depth: depth - 1, pick) }
}

// Rejected: the recursive result may be the old moved pointer.
fn fresh_or_old() {
    let old = initialized(0)
    consume(*old)
    let selected = maybe(old, 1, depth: 2, pick: false)
    consume(*selected)
}

fn recursive_slot(depth: u256) -> *ref u256 {
    if depth == 0 { core::ptr::alloc<ref u256>() }
    else { recursive_slot(depth: depth - 1) }
}

// Rejected: a recursively returned native slot is still uninitialized.
fn read_recursive_slot() {
    let slot = recursive_slot(depth: 2)
    let loaded: u256 = *slot
}

fn store(_ slot: **Item) -> *Item {
    let p = recursive(1, depth: 2)
    *slot = p
    p
}

// Rejected: the stored copy is the returned object.
fn stored_result() {
    let slot = core::ptr::alloc<*Item>()
    let p = store(slot)
    consume(*p)
    consume(*(*slot))
}

fn store_in_cycle(_ slot: **Item, depth: u256) -> *Item {
    let p = if depth == 0 { initialized(1) }
        else { store_in_cycle(slot, depth: depth - 1) }
    *slot = p
    p
}

// Rejected: a copy stored inside the recursive cycle is the returned object.
fn stored_in_cycle() {
    let slot = core::ptr::alloc<*Item>()
    let p = store_in_cycle(slot, depth: 2)
    consume(*p)
    consume(*(*slot))
}

fn write(_ p: *Item) { (*p).n = 7 }

// Rejected: a call can still write through the recursively returned object.
fn reachable_effect() {
    let p = recursive(1, depth: 2)
    let loan = mut (*p).n
    write(p)
    loan = 3
}

fn store_after_recursion(_ slot: **Item, depth: u256) -> *Item {
    if depth == 0 { initialized(1) }
    else {
        let p = store_after_recursion(slot, depth: depth - 1)
        *slot = p
        p
    }
}

// Rejected: this poststate is unsupported, so convergence fails closed.
fn unsupported_poststate() {
    let slot = core::ptr::alloc<*Item>()
    let p = store_after_recursion(slot, depth: 2)
    let n = (*p).n
}
