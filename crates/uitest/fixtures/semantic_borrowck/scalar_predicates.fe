// Trusted scalar facts separate array members only while their proof holds.
use core::ptr
struct Item { n: u256 }
fn consume(_ item: own Item) {}

// Accepted: a load of an unchanged scalar cell keeps the asserted value.
fn loaded(index: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

fn observe(_ value: usize) {}
fn overwrite(value: mut usize) { value = 0 }

// Accepted: a call that only reads the cell keeps its version.
fn call_unchanged(index: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    observe(selector)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: a call that writes the cell invalidates the asserted value.
fn call_changed(index: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    overwrite(value: mut selector)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Accepted: both branches store the same value.
fn branch_unchanged(index: usize, flag: bool) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    if flag { selector = 1 } else { selector = 1 }
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: one branch stores the moved element's index.
fn branch_changed(index: usize, flag: bool) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    if flag { selector = 0 }
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: a write through a borrow changes the cell.
fn alias_changed(index: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    let alias = mut selector
    alias = 0
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

fn pretend(_ index: usize) -> bool { true }

// Accepted: an unsigned widening cast preserves the asserted value.
fn widened(index: u8) -> u256 {
    assert!(index == 1)
    let selector: usize = index as usize
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Accepted: a trusted conjunction establishes each operand.
fn boolean_combination(index: usize, flag: bool) -> u256 {
    assert!(index == 1 && flag)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[index].n
}

// Accepted: a trusted negation of a disequality is an equality.
fn negated_inequality(index: usize) -> u256 {
    assert!(!(index != 1))
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[index].n
}

// Rejected: a truncated value says nothing about the original index.
fn truncated(index: usize) -> u256 {
    let narrow: u8 = index.downcast_truncate()
    assert!(narrow == 1)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[index].n
}

// Rejected: a signed value does not share an unsigned selector's identity.
fn signed_cast(index: i8) -> u256 {
    assert!(index == 1)
    let selector: usize = index.downcast_truncate()
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: a user function supplies no scalar fact.
fn lookalike(index: usize) -> u256 {
    assert!(pretend(index))
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[index].n
}

fn prove_one(index: usize) -> usize {
    assert!(index == 1)
    index
}
fn identity(index: usize) -> usize { index }

// Accepted: the callee's returned value carries its asserted equality.
fn proved_return(index: usize) -> u256 {
    let selector = prove_one(index)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: an unconstrained returned value may select element zero.
fn unproved_return(index: usize) -> u256 {
    let selector = identity(index)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Accepted: an immutable earlier load keeps its value after the cell changes.
fn old_value(index: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    let old = selector
    selector = 0
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[old].n
}

// Accepted: a loop that never writes the cell keeps its version.
fn stable_cell(index: usize, count: usize) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    let mut step: usize = 0
    while step < count { step += 1 }
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: a loop may change the cell before exiting.
fn changed_cell(index: usize, flag: bool) -> u256 {
    let mut selector: usize = index
    assert!(selector == 1)
    while flag {
        selector = 0
        break
    }
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

fn selected(flag: bool) -> usize {
    if flag { 1 } else { 0 }
}

// Accepted: the result correlates with the caller's asserted boolean.
fn matched(flag: bool) -> u256 {
    assert!(flag)
    let selector = selected(flag)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: an unrelated boolean does not select the result.
fn unrelated(known: bool, other: bool) -> u256 {
    assert!(known)
    let selector = selected(flag: other)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

fn set_one(value: mut usize) { value = 1 }
fn maybe_set_one(value: mut usize, flag: bool) {
    if flag { value = 1 }
}

// Accepted: the callee writes the same value on every normal return.
fn definite(index: usize) -> u256 {
    let mut selector: usize = index
    set_one(value: mut selector)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}

// Rejected: one return leaves the caller's value unchanged.
fn conditional(index: usize, flag: bool) -> u256 {
    let mut selector: usize = index
    maybe_set_one(value: mut selector, flag)
    let items = ptr::alloc<[Item; 2]>()
    *items = [Item { n: 10 }, Item { n: 20 }]
    consume((*items)[0])
    (*items)[selector].n
}
