// Copies of lanes: a `mut` access of a packed field works on a memory copy
// that the access's end stores back, and a successful halt while it is open
// stores it back first, wherever the halt happens. A field given to effects
// is one copy for all the effects it provides, held for the call; a callee
// that forwards it passes the same copy on.
use std::abi::sol
use std::evm::storage_bytes::encode_bytes_return_from_calldata

msg LanesMsg {
    #[selector = sol("arg()")]
    Arg,
    #[selector = sol("effect()")]
    Effect,
    #[selector = sol("field()")]
    Field,
    #[selector = sol("maybe(bool)")]
    Maybe { h: bool },
    #[selector = sol("pair()")]
    Pair,
    #[selector = sol("forward()")]
    Forward,
    #[selector = sol("session()")]
    Session,
}

struct Small { a: u8, b: u8 }

impl Small {
    fn a_mut(mut self) -> mut u8 {
        mut self.a
    }
}

trait Bump {
    fn bump(mut self)
}

impl Bump for u8 {
    fn bump(mut self) {
        self += 1
    }
}

impl Bump for u16 {
    fn bump(mut self) {
        self += 10
    }
}

/// Returns the 32 bytes after the selector.
fn halt() -> ! {
    encode_bytes_return_from_calldata(data_ptr: 4, len: 32)
}

fn maybe_halt(_ h: bool) {
    if h { halt() }
}

fn bump_halt(_ x: mut u8) -> ! {
    x += 1
    halt()
}

fn bump_maybe_halt(_ x: mut u8, _ h: bool) {
    x += 1
    maybe_halt(h)
}

fn bump_effect_halt() -> ! uses (x: mut u8) {
    x += 1
    halt()
}

fn pair<T: Bump, U: Bump>() uses (x: mut T, y: mut U) {
    x.bump()
    y.bump()
    x.bump()
}

fn forward() -> ! uses (x: mut u8) {
    x.bump()
    bump_effect_halt()
}

pub contract Lanes {
    mut a: u8,
    mut b: u8,
    mut c: u16,
    mut small: Small,

    recv LanesMsg {
        Arg uses (mut a) { bump_halt(mut a) }
        Effect uses (mut small) {
            with (mut small.b) { bump_effect_halt() }
        }
        Field uses (mut a) {
            with (mut a) { bump_effect_halt() }
        }
        Maybe { h } uses (mut a) {
            bump_maybe_halt(mut a, h)
            a += 10
        }
        Pair uses (mut a, mut c) {
            with (a) { pair<u8, u8>() }
            with (a, c) { pair<u8, u16>() }
        }
        Forward uses (mut b) {
            with (mut b) { forward() }
        }
        Session uses (mut small) {
            let q = mut small.a_mut()
            q = 5
            maybe_halt(true)
            q += 1
        }
    }
}
