use core::marker::{Pinned, Storage}
use core::ops::{Location, StateIndex}
use std::evm::{Address, RawStorage, keccak_words, read_transient_word, storage_at}

msg ChildMsg {
    #[selector = 0x01]
    Get -> u256,
}

pub contract Child {
    recv ChildMsg {
        Get -> u256 {
            7
        }
    }
}

/// Words at the hash of their key and the collection's number.
struct Words {}

impl Pinned for Words {
    type Space = Storage
}

unsafe impl StateIndex for Words {
    type Key = u256
    type Entry = u256

    fn locate(self, _ root: u256, _ key: u256) -> Location {
        Location { slot: keccak_words([key, root]), offset: 0 }
    }
}

/// The word at `slot`, which no field holds.
#[raw_place]
unsafe fn word_at(_ slot: u256) -> mut u256 uses (storage: mut RawStorage) {
    unsafe { storage_at(slot) }
}

fn spare(_ slot: u256) -> mut u256 uses (storage: mut RawStorage) {
    unsafe { mut word_at(slot) }
}

msg TrustMsg {
    #[selector = 0x10]
    Deploy -> Address,
    #[selector = 0x11]
    Ask { target: Address } -> u256,
    #[selector = 0x12]
    Poke { key: u256 } -> u256,
}

pub contract Trust uses (create: mut Create, call: mut Call, storage: mut RawStorage) {
    mut words: Words

    recv TrustMsg {
        Deploy -> Address uses (mut create) {
            create.create2<Child>(value: Wei::zero(), args: (), salt: 0)
        }

        Ask { target } -> u256 uses (mut call) {
            target.call(ChildMsg::Get {})
        }

        Poke { key } -> u256 uses (mut words, mut storage) {
            words[key] = 1
            let before = words[key] + read_transient_word(key)
            let word = mut spare(key + 1)
            word = 2
            before + word
        }
    }
}
