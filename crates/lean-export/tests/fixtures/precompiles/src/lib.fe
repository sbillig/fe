// fevm's precompiles as contracts, one for each. The other files of `src` are copied verbatim
// from `ingots/precompiles/src` of fe-lang/fevm at commit
// a631a777b7d1761bccfc8af4e7471643905b9354, and from its `lib.fe` so are `word_at` and the
// definitions from `SUCCESS` to `ecrecover` below. `keccak/` is fe-lang/keccak at commit
// 345d5088de986fe54b23a6aaa3a33e1c349d0960, the dependency fevm's `fe.toml` pins, for its
// `ByteSource` and `Keccak256`. The rest of this file is not fevm's.
use core::{MemBuffer, MemSpan, Option}
use core::num::swap_bytes
use keccak::{ByteSource, Keccak256}
use std::abi::sol
use std::evm::RawOps

/// The big-endian word at `offset`, zero-padded past the input as buffer_read:
/// four big-endian lanes when the input holds it.
pub fn word_at<T: ByteSource>(_ input: T, offset: usize) -> u256 {
    if offset + 32 <= input.len() {
        return (swap_bytes(input.lane_at(offset)) as u256) << 192
            | (swap_bytes(input.lane_at(offset + 8)) as u256) << 128
            | (swap_bytes(input.lane_at(offset + 16)) as u256) << 64
            | swap_bytes(input.lane_at(offset + 24)) as u256
    }
    var value: u256 = 0
    for index in offset..offset + 32 {
        value = (value << 8) | if index < input.len() { input.byte_at(index) as u256 } else { 0 }
    }
    value
}

/// The call returned output and consumed `gas_used`.
pub const SUCCESS: u8 = 0
/// An exceptional halt: invalid input or insufficient gas consumes all forwarded gas.
pub const FAILURE: u8 = 1
/// The host could not allocate the output or its working memory; this is
/// not an EVM outcome.
pub const HOST_ALLOCATION: u8 = 2

pub struct Output { pub status: u8, pub gas_used: u64, pub output: MemBuffer }

pub(ingot) fn host_allocation(_ gas_used: u64) -> Output {
    Output { status: HOST_ALLOCATION, gas_used, output: MemBuffer::empty() }
}

// An output of `source`'s bytes, eight at a time.
fn copied<T: ByteSource>(_ source: T, gas_used: u64) -> Output {
    let len = source.len()
    let Option::Some(var output) = MemBuffer::try_new(len) else { return host_allocation(gas_used) }
    var i: usize = 0
    while i + 8 <= len {
        output.write_le<u64>(offset: i, value: source.lane_at(i))
        i += 8
    }
    while i < len {
        output[i] = source.byte_at(i)
        i += 1
    }
    Output { status: SUCCESS, gas_used, output }
}

// An output of big-endian words.
fn words<const N: usize>(_ values: [u256; N], gas_used: u64) -> Output {
    let Option::Some(var output) = MemBuffer::try_new(N * 32) else { return host_allocation(gas_used) }
    for i in 0..N { output.write_word(offset: i * 32, value: values[i]) }
    Output { status: SUCCESS, gas_used, output }
}

/// The address whose secp256k1 key signed `hash` as (recovery_id, r, s), for a
/// recovery id of 0 or 1 and 0 < r, s < n; none when no key recovers.
pub fn recover_signer(hash: u256, recovery_id: u256, r: u256, s: u256) -> Option<u256> {
    let Option::Some(key) = secp256k1::recover(hash, recovery_id, r, s) else { return Option::None }
    var digest = Keccak256::new()
    digest.update_word(key.x, len: 32)
    digest.update_word(key.y, len: 32)
    Option::Some(digest.finish_word() & 0xffffffffffffffffffffffffffffffffffffffff)
}

// Recover the signer address of (hash, v, r, s). Malformed or unrecoverable
// signatures succeed with empty output.
fn ecrecover<T: ByteSource>(_ input: T) -> Output {
    let hash = word_at(input, offset: 0)
    let v = word_at(input, offset: 32)
    let r = word_at(input, offset: 64)
    let s = word_at(input, offset: 96)
    let malformed = (v != 27 && v != 28) || r == 0 || r >= secp256k1::N || s == 0 || s >= secp256k1::N
    let signer = if malformed { Option::None } else { recover_signer(hash, recovery_id: v - 27, r, s) }
    match signer {
        Option::Some(address) => words([address], gas_used: 3000),
        Option::None => Output { status: SUCCESS, gas_used: 3000, output: MemBuffer::empty() },
    }
}

// The call data, in memory.
fn input() -> MemBuffer uses (raw: mut RawOps) {
    let len = raw.calldatasize()
    var input = MemBuffer::new(len.downcast_unchecked())
    raw.calldatacopy(dest: mut input, dest_offset: 0, src_offset: 0, len)
    input
}

msg EcrecoverMsg {
    #[selector = sol("recover(uint256,uint256,uint256,uint256)")]
    Recover { hash: u256, recovery_id: u256, r: u256, s: u256 } -> (bool, u256, u256),
}

/// `recover` returns the public key (x, y) that signed `hash` as (recovery_id, r, s), after
/// `true`, or `false` and zeros when no key recovers. Its arguments are checked as fevm's
/// ECRECOVER checks them before it calls `secp256k1::recover`, which requires them.
pub contract Ecrecover {
    recv EcrecoverMsg {
        Recover { hash, recovery_id, r, s } -> (bool, u256, u256) {
            if recovery_id > 1 || r == 0 || r >= secp256k1::N || s == 0 || s >= secp256k1::N {
                return (false, 0, 0)
            }
            match secp256k1::recover(hash, recovery_id, r, s) {
                Option::Some(key) => (true, key.x, key.y),
                Option::None => (false, 0, 0),
            }
        }
    }
}

/// ECADD (0x06): every call adds the points of its call data, as `bn254::add` reads them, and
/// returns the 64 bytes of the sum, or reverts without data where the precompile fails.
pub contract Bn254Add {
    recv {
        _ uses (raw: mut RawOps) {
            match bn254::add(input()) {
                Option::Some(sum) => {
                    var output = MemBuffer::new(64)
                    output.write_word(offset: 0, value: sum[0])
                    output.write_word(offset: 32, value: sum[1])
                    raw.return_data(data: output.span())
                }
                Option::None => raw.revert(data: MemSpan::empty()),
            }
        }
    }
}

/// BLAKE2 F (0x09): every call compresses its call data as fevm's `run` checks and computes it,
/// and returns the 64 bytes of the state, or reverts without data where the precompile fails.
pub contract Blake2F {
    recv {
        _ uses (raw: mut RawOps) {
            let input = input()
            if input.len() != blake2f::INPUT_LEN || input[212] > 1 {
                raw.revert(data: MemSpan::empty())
            }
            let state = blake2f::compress(input)
            var output = MemBuffer::new(64)
            for i in 0..8 { output.write_le<u64>(offset: i * 8, value: state[i]) }
            raw.return_data(data: output.span())
        }
    }
}

/// RIPEMD-160 (0x03): every call returns the hash of its call data, as a word.
pub contract Ripemd160 {
    recv {
        _ uses (raw: mut RawOps) {
            var output = MemBuffer::new(32)
            output.write_word(offset: 0, value: hashes::ripemd160(input()))
            raw.return_data(data: output.span())
        }
    }
}

/// ECMUL (0x07): every call multiplies the point of its call data by its scalar, as `bn254::mul`
/// reads them, and returns the 64 bytes of the product, or reverts without data where the
/// precompile fails.
pub contract Bn254Mul {
    recv {
        _ uses (raw: mut RawOps) {
            match bn254::mul(input()) {
                Option::Some(product) => {
                    var output = MemBuffer::new(64)
                    output.write_word(offset: 0, value: product[0])
                    output.write_word(offset: 32, value: product[1])
                    raw.return_data(data: output.span())
                }
                Option::None => raw.revert(data: MemSpan::empty()),
            }
        }
    }
}

/// ECRECOVER (0x01) in the precompile's own format: every call returns what fevm's `ecrecover`
/// outputs for its call data, the address as a word, or nothing for a malformed or unrecoverable
/// signature.
pub contract EcrecoverPrecompile {
    recv {
        _ uses (raw: mut RawOps) {
            let result = ecrecover(input())
            raw.return_data(data: result.output.span())
        }
    }
}

/// IDENTITY (0x04): every call returns its call data, as fevm's `copied` copies it.
pub contract Identity {
    recv {
        _ uses (raw: mut RawOps) {
            let result = copied(input(), gas_used: 0)
            if result.status != SUCCESS { raw.revert(data: MemSpan::empty()) }
            raw.return_data(data: result.output.span())
        }
    }
}

/// MODEXP (0x05): every call returns what fevm's `modexp::run` outputs for its call data, given
/// all the gas a `u64` holds, so that its price never stops it, or reverts without data where
/// the precompile fails.
pub contract Modexp {
    recv {
        _ uses (raw: mut RawOps) {
            let result = modexp::run(input(), gas: 0xffffffffffffffff)
            if result.status != SUCCESS { raw.revert(data: MemSpan::empty()) }
            raw.return_data(data: result.output.span())
        }
    }
}
