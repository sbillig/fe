// The EquiVM `Examples/ERC20` token (`ERC20.sol`) written in Fe, with the same storage layout:
// `balances` at slot 0, `allowances` (a map of maps, so a Solidity nested mapping) at slot 1,
// `total_supply` at slot 2.
use std::evm::{Ctx, Log}
use std::abi::sol

msg Erc20Msg {
    #[selector = sol("transfer(address,uint256)")]
    Transfer { to: Address, value: u256 } -> bool,
    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, value: u256 } -> bool,
    #[selector = sol("transferFrom(address,address,uint256)")]
    TransferFrom { from: Address, to: Address, value: u256 } -> bool,
    #[selector = sol("balanceOf(address)")]
    BalanceOf { owner: Address } -> u256,
    #[selector = sol("allowance(address,address)")]
    Allowance { owner: Address, spender: Address } -> u256,
    #[selector = sol("totalSupply()")]
    TotalSupply -> u256,
}

#[event]
struct Transfer {
    #[indexed]
    from: Address,
    #[indexed]
    to: Address,
    value: u256,
}

#[event]
struct Approval {
    #[indexed]
    owner: Address,
    #[indexed]
    spender: Address,
    value: u256,
}

struct TokenStore {
    balances: StorageMap<Address, u256>,
    allowances: StorageMap<Address, StorageMap<Address, u256>>,
    total_supply: u256,
}

pub contract FeERC20 uses (ctx: Ctx, log: mut Log) {
    mut store: TokenStore

    init(initial_supply: u256) uses (mut store, ctx, mut log) {
        let sender = ctx.caller()
        store.balances[sender] = initial_supply
        store.total_supply = initial_supply
        log.emit(Transfer { from: Address::zero(), to: sender, value: initial_supply })
    }

    recv Erc20Msg {
        Transfer { to, value } -> bool uses (mut store, ctx, mut log) {
            let sender = ctx.caller()
            assert!(store.balances[sender] >= value, "ERC20: insufficient balance")
            store.balances[sender] -= value
            store.balances[to] = store.balances[to] + value
            log.emit(Transfer { from: sender, to, value })
            true
        }

        Approve { spender, value } -> bool uses (mut store, ctx, mut log) {
            let owner = ctx.caller()
            store.allowances[owner][spender] = value
            log.emit(Approval { owner, spender, value })
            true
        }

        TransferFrom { from, to, value } -> bool uses (mut store, ctx, mut log) {
            let spender = ctx.caller()
            let current_allowance = store.allowances[from][spender]
            assert!(current_allowance >= value, "ERC20: insufficient allowance")
            assert!(store.balances[from] >= value, "ERC20: insufficient balance")
            store.allowances[from][spender] = current_allowance - value
            store.balances[from] = store.balances[from] - value
            store.balances[to] = store.balances[to] + value
            log.emit(Transfer { from, to, value })
            true
        }

        BalanceOf { owner } -> u256 uses (store) {
            store.balances[owner]
        }

        Allowance { owner, spender } -> u256 uses (store) {
            store.allowances[owner][spender]
        }

        TotalSupply -> u256 uses (store) {
            store.total_supply
        }
    }
}
