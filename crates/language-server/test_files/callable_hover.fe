use core::functional::{Fn, FnOnce}

struct Holder<F> {
    function: F,
}

struct AddOne {}

struct Counter {
    value: u256,
}

trait Read {
    fn read(self, amount: own u256) -> u256
}

impl Counter {
    fn add(self, amount: own u256) -> u256 {
        self.value + amount
    }
}

impl Read for Counter {
    fn read(self, amount: own u256) -> u256 {
        self.value + amount
    }
}

fn increment(amount: own u256) -> u256 {
    amount + 1
}

impl FnOnce<(u256,), u256> for AddOne {
    fn call_once(self: own Self, _ args: own (u256,)) -> u256 {
        self.call(args.0)
    }
}

impl Fn<(u256,), u256> for AddOne {
    fn call(self, _ args: own (u256,)) -> u256 {
        args.0 + 1
    }
}

fn generic_hover<F: Fn<(u256,), u256>>(_ function: F) {
    let result = <|generic|>function(41)
}

fn callable_hover() {
    let offset = 1
    let add = <|literal|>|value: own u256| -> u256 { value + offset }
    let answer = <|binding|>add(41)

    let holder = Holder { function: add }
    let projected = holder.<|projected|>function
    assert(projected(41) == answer)

    let callable = AddOne {}
    let user_result = <|user_callable|>callable(41)

    let function = increment
    let function_result = <|function_item|>function(41)

    let method = Counter::add
    let method_result = <|ufcs_function_item|>method(Counter { value: 1 }, 41)

    let read = Read::read
    let read_result = <|trait_function_item|>read(Counter { value: 1 }, 41)
}
