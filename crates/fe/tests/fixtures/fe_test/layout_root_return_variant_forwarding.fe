use std::evm::{Evm, StorageMap}

enum Wrapped<const ROOT: u256 = _> {
    Map(StorageMap<u256, u256, ROOT>),
}

fn unwrap_map<const ROOT: u256>(
    wrapped: Wrapped<ROOT>,
) -> StorageMap<u256, u256, ROOT> {
    let Wrapped::Map(map) = wrapped
    map
}

// The map `unwrap_map` returns is a copy, so the caller grants the authority
// over its field.
fn read_wrapped(wrapped: Wrapped, key: u256) -> u256 uses (storage: Field(StorageMap<u256, u256>)) {
    unwrap_map(wrapped: wrapped).get(key: key)
}

msg Msg {
    #[selector = 1]
    Set { lane: usize, key: u256, value: u256 },

    #[selector = 2]
    Get { lane: usize, key: u256 } -> u256,
}

pub contract C {
    mut first: Wrapped,
    mut second: Wrapped,

    recv Msg {
        Set { lane, key, value } uses (mut first, mut second) {
            if lane == 0 {
                match first {
                    Wrapped::Map(mut map) => map.set(key: key, value: value),
                }
            } else {
                match second {
                    Wrapped::Map(mut map) => map.set(key: key, value: value),
                }
            }
        }

        Get { lane, key } -> u256 uses (first, second) {
            // The wrapped map is a place in the field this arm reads.
            if lane == 0 {
                match ref first {
                    Wrapped::Map(map) => with (map) { read_wrapped(wrapped: first, key: key) },
                }
            } else {
                match ref second {
                    Wrapped::Map(map) => with (map) { read_wrapped(wrapped: second, key: key) },
                }
            }
        }
    }
}

#[test]
fn returned_variant_values_preserve_layout_sources() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Set { lane: 1, key: 7, value: 42 },
    )
    let value: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Get { lane: 1, key: 7 },
    )
    assert!(value == 42)
    let untouched: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Get { lane: 0, key: 7 },
    )
    assert!(untouched == 0)
}
