// Storage collections are `Collection`s and `Bidirectional`. A `SolArray`'s
// elements are places: a loop views each in storage, and a `mut` loop
// updates it there. A `Copy` element is copied before the body runs, so its
// session, which reserves the array, is finished and the body may write
// storage.
use std::evm::{Evm, RawStorage, SolArray, SolEnumerableSet}
use std::evm::effects::StorPtr

// Two arrays at slots 0 and 1: distinct fields of one place, so a loop over
// one may push onto the other. (Two raw-slot constructors would each access
// all of storage.)
struct Arrays {
    a: SolArray<u256>,
    doubled: SolArray<u256>,
}

impl Arrays {
    unsafe fn at(_ slot: u256) -> mut Self uses (storage: mut RawStorage) {
        let mut ptr: StorPtr<Self> = unsafe { storage.stor_ptr(slot) }
        unsafe {
            with (ptr) {
                core::effect_ref::target_mut(ptr)
            }
        }
    }
}

#[test]
fn sol_array_loops() uses (evm: mut Evm) {
    with (RawStorage = evm) {
        let arrays = unsafe { Arrays::at(0) }
        arrays.a.push(1)
        arrays.a.push(2)
        arrays.a.push(3)

        for x in arrays.a {
            arrays.doubled.push(x * 2)
        }
        assert(arrays.doubled.len() == 3 && arrays.doubled.get(2) == 6)
        let a = mut arrays.a

        for x in mut a {
            x *= 10
        }
        assert(a.get(0) == 10 && a.get(1) == 20 && a.get(2) == 30)

        let mut weighted = 0
        for (i, x) in a.enumerate() {
            weighted += i as u256 * x
        }
        assert(weighted == 80)

        let mut tail = 0
        for x in a by core::iter::skip(1) {
            tail += x
        }
        assert(tail == 50)

        let mut digits = 0
        for x in a.reversed() {
            digits = digits * 100 + x
        }
        assert(digits == 302010)

        let empty = unsafe { SolArray<u256>::at(2) }
        for _ in empty {
            assert(false)
        }
    }
}

#[test]
fn sol_set_loops() uses (evm: mut Evm) {
    with (RawStorage = evm) {
        let s = unsafe { SolEnumerableSet<u256>::at(3) }
        assert(s.add(5))
        assert(s.add(7))
        assert(s.add(9))
        assert(s.remove(5))
        let mut sum = 0
        for v in s {
            sum += v
        }
        assert(sum == 16)

        let mut order = 0
        for v in s.reversed() {
            order = order * 10 + v
        }
        assert(order == 79)
    }
}
