use core::functional::Fn

struct ClosureHolder<F> {
    f: F,
}

struct ClosureBoxed {
    value: u256,
}

fn passthrough<T>(_ x: T) -> T {
    let f = |_ u: own u256| -> T { x }
    f.call(1)
}

fn read_default_param_rebind(boxed: ClosureBoxed) -> u256 {
    let rebound = boxed
    rebound.value
}

#[test]
fn test_generic_closure_u256() {
    let n: u256 = passthrough(41)
    assert(n == 41)
}

#[test]
fn test_generic_closure_bool() {
    let b: bool = passthrough(true)
    assert(b)
}

#[test]
fn test_call_closure_twice() {
    let g = |x: own u256| -> u256 { x + 1 }
    assert(g.call(1) == 2)
    assert(g.call(2) == 3)
}

#[test]
fn test_closure_captures_closure() {
    let add_one = |value: own u256| -> u256 { value + 1 }
    let call_captured = |_ unit: own ()| -> u256 { add_one.call(41) }
    assert(call_captured.call(()) == 42)
}

#[test]
fn test_closure_rebound_then_called() {
    let inc = |value: own u256| -> u256 { value + 1 }
    let rebound = inc
    assert(rebound.call(41) == 42)
}

#[test]
fn test_closure_stored_in_struct_and_tuple() {
    let offset: u256 = 1
    let holder = ClosureHolder { f: |value: own u256| -> u256 { value + offset } }
    let from_field = holder.f
    assert(from_field.call(41) == 42)

    let pair = (|value: own u256| -> u256 { value + 2 }, false)
    let from_tuple = pair.0
    assert(from_tuple.call(40) == 42)
}

#[test]
fn test_closure_capture_shadowing() {
    let v: u256 = 40
    let f = |value: own u256| -> u256 {
        let captured = v
        let v: u256 = 1
        captured + v + value
    }
    assert(f.call(1) == 42)
    assert(v == 40)
}

#[test]
fn test_ref_capture_closure_call_twice() {
    let x: u256 = 40
    let r = ref x
    let g = |_ unit: own ()| -> u256 { r + 1 }
    assert(g.call(()) == 41)
    assert(g.call(()) == 41)
}

#[test]
fn test_mut_capture_closure_call_twice() {
    let mut x: u256 = 40
    let m = mut x
    let g = |_ unit: own ()| -> u256 { m + 1 }
    assert(g.call(()) == 41)
    assert(g.call(()) == 41)
}

#[test]
fn test_early_return_from_closure() {
    let g = |x: own u256| -> u256 {
        if x == 0 {
            return 42
        }
        x + 1
    }
    assert(g.call(0) == 42)
    assert(g.call(5) == 6)
}

#[test]
fn test_default_param_rebind_as_ref() {
    let boxed = ClosureBoxed { value: 41 }
    assert(read_default_param_rebind(boxed) == 41)
}

#[test]
fn test_closure_default_param_rebind_as_ref() {
    let f = |boxed: ClosureBoxed| -> u256 {
        let rebound = boxed
        rebound.value
    }
    let boxed = ClosureBoxed { value: 41 }
    assert(f.call(boxed) == 41)
}
