// `map[k]` on a storage map is a session over a memory copy of the value:
// `map[k] += v` reads it, the body updates it, and the session writes it
// back. The map's field domain is the authority `Field(Self)` takes from the
// handle, which lies in the `store` effect, or from a provider of the map's
// type.
use std::evm::{Evm, StorageMap}

msg Counter {
    #[selector = 0x01]
    Bump { key: u256, by: u256 } -> u256,
    #[selector = 0x02]
    Get { key: u256 } -> u256,
    #[selector = 0x03]
    Double { key: u256 } -> u256,
}

struct Store {
    counts: StorageMap<u256, u256>,
    other: StorageMap<u256, u256>,
}

fn double(_ key: u256) uses (map: mut StorageMap<u256, u256>) {
    map[key] *= 2
}

pub contract Counts {
    mut store: Store

    recv Counter {
        Bump { key, by } -> u256 uses (mut store) {
            store.counts[key] += by
            store.other[key] = store.counts[key] * 2
            store.counts[key]
        }
        Get { key } -> u256 uses store {
            store.counts[key] + store.other[key]
        }
        Double { key } -> u256 uses (mut store) {
            // Distinct fields are disjoint: `other` stays writable while
            // `counts`' element is open.
            let count = mut store.counts[key]
            store.other[key] = count
            count += 1
            with (mut store.counts) {
                double(key)
            }
            store.counts[key]
        }
    }
}

#[test]
fn indexing_writes_back() uses (evm: mut Evm) {
    let addr = evm.create2<Counts>(value: 0, args: (), salt: 0)
    let a: u256 = evm.call(addr: addr, gas: 100000, value: 0, message: Counter::Bump { key: 1, by: 5 })
    assert!(a == 5)
    let b: u256 = evm.call(addr: addr, gas: 100000, value: 0, message: Counter::Bump { key: 1, by: 2 })
    assert!(b == 7)
    let c: u256 = evm.call(addr: addr, gas: 100000, value: 0, message: Counter::Get { key: 1 })
    assert!(c == 21)
    let d: u256 = evm.call(addr: addr, gas: 100000, value: 0, message: Counter::Double { key: 1 })
    assert!(d == 16)
    let e: u256 = evm.call(addr: addr, gas: 100000, value: 0, message: Counter::Get { key: 1 })
    assert!(e == 23)
}
