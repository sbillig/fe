// Mutable views write their owners: a `mut` span from `span_mut` or
// `slice_mut`, a generic `mut MemSlice` parameter, the halves of
// `split_at_mut`, and owner-side byte indexing on `MemBuffer`.
use core::ptr::{MemArray, MemBuffer, MemSlice}

fn fill<T: Copy>(_ s: mut MemSlice<T>, _ v: T) {
    for mut x in s {
        x = v
    }
}

#[test]
fn mutable_views_write_their_owners() {
    var buf = MemBuffer::alloc(8)
    let s = buf.span_mut()
    s[0] = 10
    assert!(buf[0] == 10)
    let part = buf.slice_mut(offset: 2, len: 3)
    fill(mut part, 7)
    assert!(buf[1] == 0 && buf[2] == 7 && buf[4] == 7 && buf[5] == 0)
    buf[7] = 9
    assert!(buf.span().byte_at(7) == 9)

    var xs = MemArray<u256>::new_zeroed(4)
    let all = xs.as_mut_slice()
    let (mut head, mut tail) = all.split_at_mut(1)
    head[0] = 1
    tail[0] = 2
    tail.at_mut(2) += 3
    assert!(xs[0] == 1 && xs[1] == 2 && xs[2] == 0 && xs[3] == 3)
}
