// A recv arm may return a zero-sized type that encodes to a non-empty payload.
use core::abi::{AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode}
use std::abi::Sol

struct Unit {}

impl AbiSize for Unit {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl Encode<Sol> for Unit {
    fn encode(own self, _ out: AbiFrame) {
        out.store_word(at: 0, value: 7)
    }
}

impl Decode<Sol> for Unit {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Unit {}
    }
}

msg M {
    #[selector = 0x01]
    Get -> Unit,
}

pub contract C {
    recv M {
        Get {} -> Unit {
            Unit {}
        }
    }
}

#[test]
fn test_recv_returns_zero_sized_type() uses (evm: mut Evm) {
    let addr = evm.create2<C>(value: Wei::zero(), args: (), salt: 0)
    let _: Unit = evm.call(addr: addr, gas: 1000000, value: Wei::zero(), message: M::Get {})
}
