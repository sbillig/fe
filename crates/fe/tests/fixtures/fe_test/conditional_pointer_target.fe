use core::{Option, ptr}
struct Token { data: *u8 }
struct Buffer { data: *u8, marker: u256 }
fn clear(_ state: mut Buffer) {
    ptr::zero_bytes(ptr: state.data, len: 1)
    state.marker = 1
}
fn release(_ value: own Token) {
    ptr::zero_bytes(ptr: value.data, len: 1)
}
struct Stack { slots: *Option<Token>, len: usize }
impl Stack {
    fn pop(mut self) -> Token {
        assert(self.len > 0)
        let index = self.len - 1
        let slots = self.slots
        self.len = index
        let value = *slots
        *slots = Option::None
        match value {
            Option::Some(value,) => value,
            Option::None => core::panic(),
        }
    }
    fn len(self) -> usize {
        self.len
    }
}
fn run_children(_ state: mut Buffer, _ first: own Token) {
    let slots = ptr::alloc<Option<Token>>()
    *slots = Option::Some(first)
    let mut frames = Stack { slots, len: 1 }
    while frames.len() > 0 {
        let value = frames.pop()
        clear(mut state)
        release(value)
    }
}
#[test]
fn popping_a_slot_keeps_unrelated_writes_separate() {
    let data = ptr::alloc<u8>()
    *data = 12
    let child = ptr::alloc<u8>()
    *child = 25
    let mut state = Buffer { data, marker: 0 }
    run_children(mut state, Token { data: child })
    assert(*data == 0)
    assert(*child == 0)
    assert(state.marker == 1)
}
