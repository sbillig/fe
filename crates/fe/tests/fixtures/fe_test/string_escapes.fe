const CONTROLS: [u8; 5] = "\"\\\n\r\t"

#[test]
fn string_escapes() {
    assert!(CONTROLS[0] == 34)
    assert!(CONTROLS[1] == 92)
    assert!(CONTROLS[2] == 10)
    assert!(CONTROLS[3] == 13)
    assert!(CONTROLS[4] == 9)
    let text: String<3> = "é\n"
    assert!(text.len() == 3)
    let bytes = text.as_bytes()
    assert!(bytes[0] == 195)
    assert!(bytes[1] == 169)
    assert!(bytes[2] == 10)
    let literal: [u8; 2] = "\\n"
    assert!(literal[0] == 92)
    assert!(literal[1] == 110)
}
