struct Node {
    value: u256,
    next: *Node,
}

struct A {
    value: u256,
    b: *B,
}

struct B {
    value: u256,
    a: *A,
}

struct GNode<T> {
    value: T,
    next: *GNode<T>,
}

enum Link {
    Nil,
    Cons(*ENode),
}

struct ENode {
    value: u256,
    next: Link,
}

struct ONode {
    value: u256,
    next: Option<*ONode>,
}

struct Tree {
    value: u256,
    kids: [*Tree; 2],
}

struct Pair {
    value: u256,
    link: (u256, *Pair),
}

struct PNode {
    value: u256,
    next: **PNode,
}

fn next_value(_ p: *Node) -> u256 {
    p.next.value
}

fn follow(_ p: *Node) -> *Node {
    p.next
}

fn node_sum(_ n: Node) -> u256 {
    n.value + n.next.value
}

fn make_node(value: u256, _ next: *Node) -> Node {
    Node { value, next }
}

fn pick(_ first: *Node, _ second: *Node, use_first: bool) -> *Node {
    if use_first { first } else { second }
}

fn walk(_ start: *Node, steps: u256) -> u256 {
    let mut p = start
    let mut i: u256 = 0
    while i < steps {
        p = p.next
        i += 1
    }
    p.value
}

fn generic_next<T: Copy>(_ p: *GNode<T>) -> T {
    p.next.value
}

#[test]
fn test_self_recursive_reads_writes_and_copies() {
    let tail = core::ptr::alloc<Node>()
    tail.value = 20
    tail.next = tail
    let head = core::ptr::alloc<Node>()
    head.value = 10
    head.next = tail
    assert(next_value(head) == 20)
    assert(head.next.next.value == 20)

    head.next.value = 21
    assert(tail.value == 21)

    // A whole-value copy copies the pointer, not the referent.
    let copy = *head
    let slot = core::ptr::alloc<Node>()
    *slot = copy
    assert(slot.value == 10)
    slot.next.value = 22
    assert(tail.value == 22)
    assert(core::size_of<Node>() == 64)
}

#[test]
fn test_recursive_params_returns_and_values() {
    let tail = core::ptr::alloc<Node>()
    tail.value = 7
    tail.next = tail
    let head = core::ptr::alloc<Node>()
    *head = make_node(value: 5, tail)
    assert(follow(head) == tail)
    let second = follow(follow(head))
    assert(second.value == 7)
    assert(node_sum(*head) == 12)
    let built = make_node(value: 1, head)
    assert(node_sum(built) == 6)
}

// Each test calls a joining or looping helper at most once: repeated calls
// currently stall the frontend borrow checker on recursive raw pointees.
#[test]
fn test_recursive_joins() {
    let b = core::ptr::alloc<Node>()
    b.value = 2
    b.next = b
    let a = core::ptr::alloc<Node>()
    a.value = 1
    a.next = b
    let second = pick(a, b, use_first: false)
    assert(second.value == 2)
    let chosen = if a.value == 1 { a.next } else { a }
    assert(chosen.next.value == 2)
}

#[test]
fn test_recursive_loops() {
    let c = core::ptr::alloc<Node>()
    c.value = 3
    let b = core::ptr::alloc<Node>()
    b.value = 2
    b.next = c
    let a = core::ptr::alloc<Node>()
    a.value = 1
    a.next = b
    c.next = a
    assert(walk(a, steps: 4) == 2)
}

#[test]
fn test_mutual_recursion() {
    let a = core::ptr::alloc<A>()
    let b = core::ptr::alloc<B>()
    a.value = 1
    a.b = b
    b.value = 2
    b.a = a
    assert(a.b.value == 2)
    assert(a.b.a.b.a.value == 1)
    b.a.value = 9
    assert(a.value == 9)
}

#[test]
fn test_generic_recursion() {
    let n = core::ptr::alloc<GNode<u8>>()
    n.value = 3
    n.next = n
    assert(n.next.next.value == 3)
    assert(generic_next(n) == 3)

    let w = core::ptr::alloc<GNode<u256>>()
    w.value = 300
    w.next = w
    assert(generic_next(w) == 300)
}

// Matching a pointer out of these recursive payloads, or passing such a
// payload to a function, currently stalls the frontend borrow checker;
// construction, storage, and whole-value copies are covered here.
#[test]
fn test_enum_payload_recursion() {
    let last = core::ptr::alloc<ENode>()
    last.value = 4
    last.next = Link::Nil
    let first = core::ptr::alloc<ENode>()
    first.value = 6
    first.next = Link::Cons(last)
    let copy = *first
    let slot = core::ptr::alloc<ENode>()
    *slot = copy
    assert(slot.value == 6)
    last.next = Link::Cons(first)
    assert(last.value == 4)

    let o2 = core::ptr::alloc<ONode>()
    o2.value = 2
    o2.next = Option::None
    let o1 = core::ptr::alloc<ONode>()
    o1.value = 1
    o1.next = Option::Some(o2)
    let node = *o1
    assert(node.value == 1)
    assert(node.next.is_some())
    assert(o2.next.is_none())
}

#[test]
fn test_pointer_arrays_tuples_and_nested_pointers() {
    let leaf = core::ptr::alloc<Tree>()
    leaf.value = 5
    leaf.kids = [leaf, leaf]
    let root = core::ptr::alloc<Tree>()
    root.value = 1
    root.kids = [leaf, root]
    assert(root.kids[0].value == 5)
    assert(root.kids[1].kids[0].kids[1].value == 5)

    let pair = core::ptr::alloc<Pair>()
    pair.value = 8
    pair.link = (1, pair)
    assert(pair.link.1.link.1.value == 8)

    let node = core::ptr::alloc<PNode>()
    let cell = core::ptr::alloc<*PNode>()
    *cell = node
    node.value = 11
    node.next = cell
    assert((*node.next).value == 11)
    assert((*(*node.next).next).value == 11)
}
