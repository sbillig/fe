use core::ptr

extern {
    fn __fe_rpc_eth_block_number_u64() -> i64
    fn __fe_rpc_eth_block_number(out: u64, out_cap: u64) -> i64
    fn __fe_rpc_eth_call(
        to: u64,
        to_len: u64,
        data: u64,
        data_len: u64,
        out: u64,
        out_cap: u64,
    ) -> i64
}

pub struct RpcResponse {
    pub status: i64,
    pub len: i64,
}

pub struct RpcValue {
    pub status: i64,
    pub value: i64,
}

pub trait EthereumRpc {
    fn block_number(mut self) -> RpcValue
    fn block_number_hex(mut self, out: ptr::MemorySlice<u8>) -> RpcResponse
    fn call(mut self, to: ptr::MemorySlice<u8>, data: ptr::MemorySlice<u8>, out: ptr::MemorySlice<u8>) -> RpcResponse
}

pub struct HostRpc {
    token: u8,
}

pub fn host() -> HostRpc {
    HostRpc { token: 0 }
}

impl EthereumRpc for HostRpc {
    fn block_number(mut self) -> RpcValue {
        value_response(__fe_rpc_eth_block_number_u64())
    }

    fn block_number_hex(mut self, out: ptr::MemorySlice<u8>) -> RpcResponse {
        let status = __fe_rpc_eth_block_number(addr64(out.ptr), out.len.downcast_unchecked())
        response(status)
    }

    fn call(mut self, to: ptr::MemorySlice<u8>, data: ptr::MemorySlice<u8>, out: ptr::MemorySlice<u8>) -> RpcResponse {
        let status = __fe_rpc_eth_call(
            addr64(to.ptr),
            to.len.downcast_unchecked(),
            addr64(data.ptr),
            data.len.downcast_unchecked(),
            addr64(out.ptr),
            out.len.downcast_unchecked(),
        )
        response(status)
    }
}

fn addr64<T>(_ ptr: *T) -> u64 {
    ptr::addr(ptr).downcast_unchecked()
}

fn value_response(_ status: i64) -> RpcValue {
    if status >= 0 {
        RpcValue {
            status: 0,
            value: status,
        }
    } else {
        RpcValue { status, value: 0 }
    }
}

fn response(_ status: i64) -> RpcResponse {
    if status >= 0 {
        RpcResponse {
            status: 0,
            len: status,
        }
    } else {
        RpcResponse { status, len: 0 }
    }
}
